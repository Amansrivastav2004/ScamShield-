# ScamShield Environment Variables Configuration

# Flask Core Settings
FLASK_ENV=production
DEBUG=False
PORT=5000
SECRET_KEY=scamshield_super_secret_cyber_security_key_2026

# AI / Rule Engine Configuration (rule_based or ai_powered)
AI_PROVIDER=rule_based
GEMINI_API_KEY=your_optional_gemini_api_key_here

# Cloud OCR API Service (Optional fallback for Vercel/Serverless where Tesseract binary is absent)
OCR_SPACE_API_KEY=your_optional_ocr_space_api_key_here

# Production Cloudflare D1 REST API Database Persistence (Optional)
CLOUDFLARE_D1_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_cloudflare_d1_database_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
